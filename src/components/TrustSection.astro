---
// TrustSection.astro - Credibility through transparency without fake reviews
const trustCards = [
  {
    title: 'Clear Communication',
    description: 'Straightforward project updates, direct email and phone contact, and realistic expectations at every step.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`
  },
  {
    title: 'Practical Solutions',
    description: 'I build what solves your actual business problem. No bloated code, unnecessary frameworks, or technical debt you never asked for.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>`
  },
  {
    title: 'Defined Scope',
    description: 'Deliverables, milestones, timeline, and exact pricing are agreed upon before development begins. No hidden line items.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`
  },
  {
    title: 'Reliable Handoff',
    description: 'You receive complete source code, deployment configuration, and clear documentation. You own your software assets.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>`
  },
  {
    title: 'Ongoing Support',
    description: 'I do not disappear after launch. Monthly maintenance, security monitoring, and incremental enhancements are readily available.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`
  }
];
---

<section class="section trust-section" id="trust">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Engineering Standards</span>
      <h2>What You Can Expect</h2>
      <p>
        Credibility built on honest communication, transparent pricing, and dependable software execution.
      </p>
    </div>

    <div class="trust-grid">
      {trustCards.map((card) => (
        <div class="trust-card card">
          <div class="trust-icon" set:html={card.icon} />
          <h3 class="trust-title">{card.title}</h3>
          <p class="trust-desc">{card.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  @media (max-width: 992px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .trust-grid {
      grid-template-columns: 1fr;
    }
  }

  .trust-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 2rem;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .trust-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-medium);
  }

  .trust-icon {
    width: 46px;
    height: 46px;
    border-radius: var(--radius-sm);
    background: var(--accent-surface);
    border: 1px solid var(--accent-border);
    color: var(--accent-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .trust-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.65rem;
  }

  .trust-desc {
    font-size: 0.925rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }
</style>
