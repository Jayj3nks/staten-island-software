---
import { siteConfig, hasEmail, hasPhone, hasGitHub, hasFiverr, hasLinkedIn } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-grid">
      <!-- Business Info Column -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <div class="footer-logo-mark" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 31 L13 9 L15 9 L16 31" stroke="#38bdf8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M31 31 L27 9 L25 9 L24 31" stroke="#38bdf8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M5 17 Q20 25 35 17" stroke="#2563eb" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M4 31 L36 31" stroke="#475569" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M17 23 L15 24.5 L17 26" stroke="#f8fafc" stroke-width="1.3" stroke-linecap="round"/>
              <path d="M23 23 L25 24.5 L23 26" stroke="#f8fafc" stroke-width="1.3" stroke-linecap="round"/>
              <path d="M21 21.5 L19 27.5" stroke="#38bdf8" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <span class="footer-brand-name">STATEN ISLAND</span>
            <span class="footer-brand-sub">SOFTWARE</span>
          </div>
        </div>
        <p class="footer-desc">
          Independent software engineering for businesses, entrepreneurs, and organizations. Building practical websites, internal tools, and automations.
        </p>
        <div class="footer-service-area">
          <span class="service-dot" aria-hidden="true"></span>
          <span>{siteConfig.serviceArea}</span>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-col">
        <h3 class="footer-heading">Navigation</h3>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href="/work">Work / Demos</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Request a Quote</a></li>
        </ul>
      </div>

      <!-- Services List -->
      <div class="footer-col">
        <h3 class="footer-heading">Capabilities</h3>
        <ul class="footer-links">
          <li><a href="/services/web-development">Website Development</a></li>
          <li><a href="/services/custom-software">Custom Software & Dashboards</a></li>
          <li><a href="/services/automation">Business Automation</a></li>
          <li><a href="/services/integrations">API & System Integration</a></li>
          <li><a href="/services/ai">Practical AI Solutions</a></li>
          <li><a href="/pricing#support">Maintenance & Support</a></li>
        </ul>
      </div>

      <!-- Contact & Trust Column -->
      <div class="footer-col">
        <h3 class="footer-heading">Direct Engagement</h3>
        <p class="footer-contact-text">
          Have a project in mind or need a technical consultation? Fill out the quote form for a scoped proposal.
        </p>
        <div class="footer-cta-container">
          <a href="/contact" class="btn btn-outline btn-sm" style="width: 100%; text-align: center;">
            Contact / Request Quote
          </a>
        </div>

        <!-- Rendered ONLY when real verified details are set in siteConfig -->
        <ul class="footer-social-links">
          {hasEmail && (
            <li>
              <a href={`mailto:${siteConfig.contactEmail}`} class="social-link" aria-label="Email">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 7L2 7"/></svg>
                <span>{siteConfig.contactEmail}</span>
              </a>
            </li>
          )}
          {hasPhone && (
            <li>
              <a href={`tel:${siteConfig.phone}`} class="social-link" aria-label="Phone">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <span>{siteConfig.phone}</span>
              </a>
            </li>
          )}
          {hasGitHub && (
            <li>
              <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub Profile">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                <span>GitHub</span>
              </a>
            </li>
          )}
          {hasFiverr && (
            <li>
              <a href={siteConfig.fiverrUrl} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Fiverr Profile">
                <span class="fiverr-badge">Fiverr Profile</span>
              </a>
            </li>
          )}
          {hasLinkedIn && (
            <li>
              <a href={siteConfig.linkedInUrl} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn Profile">
                <span>LinkedIn</span>
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="copyright">
        © {currentYear} {siteConfig.businessName}. Independent Software Engineering. All rights reserved.
      </div>
      <div class="footer-legal-links">
        <a href="/privacy">Privacy Policy</a>
        <span class="separator" aria-hidden="true">•</span>
        <a href="/terms">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
    padding-top: 4.5rem;
    padding-bottom: 2.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.3fr 1.5fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  .brand-col {
    padding-right: 1.5rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.2rem;
  }

  .footer-logo-mark {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3px;
  }

  .footer-logo-mark svg {
    width: 100%;
    height: 100%;
  }

  .footer-brand-name {
    display: block;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .footer-brand-sub {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent-glow);
  }

  .footer-desc {
    font-size: 0.925rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .footer-service-area {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .service-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.4);
  }

  .footer-heading {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    font-size: 0.925rem;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--accent-glow);
  }

  .footer-contact-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.2rem;
  }

  .footer-cta-container {
    margin-bottom: 1.25rem;
  }

  .footer-social-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .social-link:hover {
    color: var(--accent-glow);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.85rem;
    color: var(--text-subtle);
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-legal-links a {
    color: var(--text-subtle);
    font-size: 0.85rem;
  }

  .footer-legal-links a:hover {
    color: var(--text-secondary);
  }

  .separator {
    color: var(--border-medium);
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
