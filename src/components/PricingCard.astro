---
import type { PricingTier } from '../data/pricing';

interface Props {
  tier: PricingTier;
}

const { tier } = Astro.props;
const contactUrl = `/contact?service=${encodeURIComponent(tier.serviceParam)}`;
---

<div class={`pricing-card card ${tier.popular ? 'is-popular' : ''}`}>
  {tier.popular && (
    <div class="popular-badge-wrapper">
      <span class="badge badge-popular">Popular Choice</span>
    </div>
  )}

  <div class="pricing-header">
    <h3 class="tier-name">{tier.name}</h3>
    <div class="price-display">
      {tier.isStartingPrice && <span class="starting-label">Starting at</span>}
      <div class="amount-wrap">
        <span class="price-amount">{tier.price}</span>
        {tier.frequency && <span class="frequency">{tier.frequency}</span>}
      </div>
    </div>
    <p class="tier-desc">{tier.description}</p>
  </div>

  <div class="ideal-for-box">
    <strong>Best for:</strong> {tier.idealFor}
  </div>

  <div class="features-divider" aria-hidden="true"></div>

  <ul class="features-list" aria-label={`Included features for ${tier.name}`}>
    {tier.features.map((feature) => (
      <li>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="20 6 9 17 4 12" />
        </svg>
        <span>{feature}</span>
      </li>
    ))}
  </ul>

  <div class="pricing-cta-wrap">
    <a 
      href={contactUrl} 
      class={`btn ${tier.popular ? 'btn-primary' : 'btn-secondary'} btn-lg`} 
      style="width: 100%; text-align: center;"
    >
      Request This Project
    </a>
  </div>
</div>

<style>
  .pricing-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    padding: 2.5rem 2rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .pricing-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  .pricing-card.is-popular {
    border-color: var(--accent-glow);
    background: linear-gradient(180deg, rgba(37, 99, 235, 0.08) 0%, var(--bg-card) 40%);
    box-shadow: 0 0 24px rgba(37, 99, 235, 0.2);
  }

  .popular-badge-wrapper {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
  }

  .pricing-header {
    margin-bottom: 1.25rem;
  }

  .tier-name {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .price-display {
    margin-bottom: 1rem;
  }

  .starting-label {
    display: block;
    font-size: 0.825rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .amount-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .price-amount {
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .frequency {
    font-size: 1rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .tier-desc {
    font-size: 0.925rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .ideal-for-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .ideal-for-box strong {
    color: var(--text-secondary);
  }

  .features-divider {
    height: 1px;
    background: var(--border-subtle);
    margin-bottom: 1.5rem;
  }

  .features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .features-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .features-list svg {
    flex-shrink: 0;
    color: var(--accent-glow);
    margin-top: 2px;
  }

  .pricing-cta-wrap {
    margin-top: auto;
  }
</style>
