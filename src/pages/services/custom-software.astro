---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/services';
import { siteConfig } from '../../config/site';

const service = services.find((s) => s.slug === 'custom-software')!;
const pageTitle = `Custom Software & Internal Tools | ${siteConfig.businessName}`;
const pageDesc = 'Tailored operations dashboards, internal workflow applications, and lightweight custom tools built around the way your business actually operates.';

const serviceSchema = {
  name: 'Custom Software Development',
  description: service.summary,
  category: 'SoftwareEngineering'
};
---

<Layout title={pageTitle} description={pageDesc} serviceData={serviceSchema}>
  <section class="section service-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/services">Services</a>
        <span class="sep">/</span>
        <span>Custom Software</span>
      </div>

      <div class="service-hero-grid">
        <div class="hero-left">
          <span class="section-tag">Internal Tools & Web Apps</span>
          <h1>{service.headline}</h1>
          <p class="lead-text">
            Need an internal tool to replace a spreadsheet-heavy process? I build focused web applications and operational dashboards tailored directly around your team's real workflow.
          </p>
          <div class="hero-cta-group">
            <a href="/contact?service=Custom%20Software" class="btn btn-primary btn-lg">
              Discuss Your Tool Requirements
            </a>
            <a href="/pricing#software" class="btn btn-secondary btn-lg">
              View Software Starting Rates
            </a>
          </div>
        </div>

        <div class="hero-right">
          <div class="rate-callout-card card">
            <span class="badge badge-blue">Transparent Scope</span>
            <h3>Custom Software Rates</h3>
            <div class="rate-item">
              <span class="rate-name">Custom Dashboard / Internal Tool</span>
              <span class="rate-price">Starting at $699</span>
            </div>
            <div class="rate-item">
              <span class="rate-name">Small Custom Web Application</span>
              <span class="rate-price">Starting at $1,499</span>
            </div>
            <div class="rate-item">
              <span class="rate-name">Software Engineering / Consulting</span>
              <span class="rate-price">$45 / hour</span>
            </div>
            <p class="rate-note">
              Every project receives a written deliverable scope before work begins.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section">
    <div class="container">
      <div class="section-header text-left">
        <span class="section-tag">Capabilities</span>
        <h2>What I Engineer for Internal Operations</h2>
      </div>

      <div class="grid-2">
        {service.offerings.map((offering) => (
          <div class="offering-card card">
            <div class="offering-icon">⚡</div>
            <span class="offering-title">{offering}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Practical Use Cases -->
  <section class="section practical-section">
    <div class="container">
      <div class="section-header text-left">
        <span class="section-tag">Case Studies & Examples</span>
        <h2>How Custom Tools Solve Real Bottlenecks</h2>
      </div>

      <div class="grid-3">
        {service.practicalUseCases.map((useCase) => (
          <div class="usecase-card card">
            <h3>{useCase.title}</h3>
            <p>{useCase.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Expectations -->
  <section class="section">
    <div class="container">
      <div class="section-header text-left">
        <span class="section-tag">Development Standards</span>
        <h2>What You Can Expect</h2>
      </div>

      <div class="grid-2">
        {service.whatToExpect.map((item) => (
          <div class="handoff-card card">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="check-icon"><polyline points="20 6 9 17 4 12"/></svg>
            <p>{item}</p>
          </div>
        ))}
      </div>

      <div class="bottom-cta-box card">
        <h3>Ready to retire fragile spreadsheets?</h3>
        <p>
          Describe what data you track and where manual bottlenecks occur. I will map out a sensible tool structure.
        </p>
        <a href="/contact?service=Custom%20Software" class="btn btn-primary btn-lg">
          Request a Custom Software Proposal
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-hero {
    padding-top: 3.5rem;
    padding-bottom: 4rem;
    background: radial-gradient(ellipse 60% 40% at 30% 0%, rgba(37, 99, 235, 0.12), transparent 70%);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .breadcrumb a {
    color: var(--accent-glow);
  }

  .service-hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3.5rem;
    align-items: center;
  }

  .lead-text {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 1.25rem 0 2rem 0;
  }

  .hero-cta-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .rate-callout-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-medium);
    padding: 2.25rem;
  }

  .rate-callout-card h3 {
    font-size: 1.25rem;
    margin: 0.75rem 0 1.25rem 0;
  }

  .rate-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.925rem;
  }

  .rate-name {
    color: var(--text-secondary);
  }

  .rate-price {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-glow);
  }

  .rate-note {
    font-size: 0.825rem;
    color: var(--text-muted);
    margin-top: 1rem;
  }

  .offering-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--bg-surface);
  }

  .offering-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent-surface);
    border: 1px solid var(--accent-border);
    color: var(--accent-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    flex-shrink: 0;
  }

  .offering-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .practical-section {
    background: var(--bg-surface);
  }

  .usecase-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
  }

  .usecase-card p {
    font-size: 0.925rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .handoff-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--bg-surface);
  }

  .check-icon {
    color: var(--success);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .bottom-cta-box {
    margin-top: 3.5rem;
    padding: 3rem 2rem;
    text-align: center;
    background: var(--bg-surface);
    border: 1px solid var(--accent-border);
  }

  .bottom-cta-box h3 {
    font-size: 1.65rem;
    margin-bottom: 0.75rem;
  }

  .bottom-cta-box p {
    font-size: 1.05rem;
    max-width: 550px;
    margin: 0 auto 1.75rem auto;
  }

  @media (max-width: 900px) {
    .service-hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
